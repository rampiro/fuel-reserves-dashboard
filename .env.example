# ============================================================
# .env.example — Copia este archivo a .env y rellena las claves
# ============================================================

# EIA (US Energy Information Administration)
# Registro gratuito en: https://www.eia.gov/opendata/register.php
EIA_API_KEY=tu_clave_eia_aqui

# IEA (International Energy Agency)
# Requiere cuenta en: https://www.iea.org/data-and-statistics
# La API pública tiene acceso limitado; algunos datos requieren suscripción
IEA_API_KEY=tu_clave_iea_aqui

# CORES (España) — No requiere clave; descarga automática de Excel mensual
# No hay variables necesarias para CORES

# OPEP — Los datos históricos están disponibles como CSV descargable
# https://www.opec.org/opec_web/en/data_graphs/40.htm
# No hay API REST pública oficial; se recomienda descargar y cargar en PostgreSQL
